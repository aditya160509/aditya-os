{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "site/outer/public",
  "installCommand": "npm run install:all",
  "framework": null,
  "headers": [
    {
      "source": "/wallpapers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/desktop/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
